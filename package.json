{
  "name": "soporte-tecnico-agente",
  "version": "1.0.0",
  "description": "Agente de soporte tecnico autonomo (Nivel 1) con Express y frontend vanilla JS",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "eval": "node --env-file-if-exists=.env eval/run.js",
    "eval:acuerdo": "node eval/acuerdo.js",
    "eval:revision": "node eval/exportar-revision.js"
  },
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@supabase/supabase-js": "^2.117.2",
    "cookie": "0.6.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0"
  }
}
